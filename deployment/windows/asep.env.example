# Copy outside every release to %USERPROFILE%\ASEP-Beta\config\production.env.
# Restrict its ACL to the dedicated Beta account. This template has no secret.
ASEP_ENVIRONMENT=production
ASEP_STORAGE_BACKEND=sqlite
ASEP_SQLITE_DATABASE=%USERPROFILE%\ASEP-Beta\data\asep.db
ASEP_HOSTED_ROOT=%USERPROFILE%\ASEP-Beta\workspaces
ASEP_MAINTENANCE_DIRECTORY=%USERPROFILE%\ASEP-Beta\temp\maintenance
ASEP_BACKUP_ROOT=%USERPROFILE%\ASEP-Beta\backups
ASEP_PUBLIC_ORIGIN=https://temporary-beta-address.example.invalid
ASEP_CORS_ORIGINS=https://temporary-beta-address.example.invalid
ASEP_ACCESS_COOKIE_SECURE=true
ASEP_LEGACY_ADMIN_EMAIL=replace-at-deploy-time@example.invalid
ASEP_LEGACY_ADMIN_PASSWORD=replace-with-external-secret
# The supervisor overwrites these two values with the confined active release.
ASEP_AGENT_CATALOG_DIRECTORY=%USERPROFILE%\ASEP-Beta\releases\replace-release-id\registry
ASEP_RELEASE_ROOT=%USERPROFILE%\ASEP-Beta\releases\replace-release-id
CODEX_HOME=%USERPROFILE%\ASEP-Beta\codex
NEXT_PUBLIC_API_URL=https://temporary-beta-address.example.invalid
