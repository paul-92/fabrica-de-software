# Install as /etc/asep/asep.env with mode 0640 and ownership root:asep.
# This committed file contains no real credentials.
ASEP_ENVIRONMENT=production
ASEP_STORAGE_BACKEND=sqlite
ASEP_SQLITE_DATABASE=/var/lib/asep/asep.db
ASEP_HOSTED_ROOT=/var/lib/asep/workspaces
ASEP_CORS_ORIGINS=https://beta.example.invalid
ASEP_ACCESS_COOKIE_SECURE=true
ASEP_LEGACY_ADMIN_EMAIL=admin@example.invalid
ASEP_LEGACY_ADMIN_PASSWORD=replace-with-secret-at-deploy-time
ASEP_AGENT_CATALOG_DIRECTORY=/opt/asep/current/registry
ASEP_RELEASE_ROOT=/opt/asep/current
CODEX_HOME=/var/lib/asep/codex
PATH=/opt/asep/current/.venv/bin:/usr/local/bin:/usr/bin
NEXT_PUBLIC_API_URL=https://beta.example.invalid
