# Development defaults (local only)
ASEP_ENVIRONMENT=development
ASEP_STORAGE_BACKEND=memory

# Backend file
ASEP_STORAGE_DIRECTORY=storage
ASEP_RUNS_FILENAME=runs.json
ASEP_TIMELINE_FILENAME=timeline-events.json
ASEP_WORKFLOWS_FILENAME=workflow-snapshots.json

# Backend sqlite
ASEP_SQLITE_DATABASE=storage/asep.db

# Production template (replace placeholders; never commit the password)
# ASEP_ENVIRONMENT=production
# ASEP_STORAGE_BACKEND=sqlite
# ASEP_SQLITE_DATABASE=/var/lib/asep/database/asep.db
# ASEP_HOSTED_ROOT=/var/lib/asep/workspaces
# ASEP_CORS_ORIGINS=https://beta.example
# ASEP_ACCESS_COOKIE_SECURE=true
# ASEP_LEGACY_ADMIN_EMAIL=admin@example.invalid
# ASEP_LEGACY_ADMIN_PASSWORD=<injected-secret-with-at-least-12-characters>
# NEXT_PUBLIC_API_URL=https://beta.example
